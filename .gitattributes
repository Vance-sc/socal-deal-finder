# Keep the authorship check files LF on every platform (Windows checkouts
# with CRLF would break the shell script). Append these lines to the repo's
# .gitattributes, or rename this file to .gitattributes if there is none.
tools/authorship-check.sh text eol=lf
tools/install-hooks.sh text eol=lf
tools/authorship-check.patterns text eol=lf
.authorship-check.conf text eol=lf
.githooks/* text eol=lf
